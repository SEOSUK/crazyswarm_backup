<?xml version="1.0" ?>
<robot name="log_player_crazyflie">
  <link name="crazyflie">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.032" ixy="0" ixz="0" iyy="0.032" iyz="0" izz="0.00012"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://flying_pen/models/meshes/crazyflie.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <link name="end_effector">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://flying_pen/models/meshes/EE.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="crazyflie_to_end_effector" type="fixed">
    <parent link="crazyflie"/>
    <child link="end_effector"/>
    <origin xyz="0.09 0.0 0.085" rpy="0 0 0"/>
  </joint>
</robot>
